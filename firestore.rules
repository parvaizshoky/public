rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Users Collection - Allow manual and Google users to register and update profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Deposits Collection (USDT TRC-20)
    match /deposits/{depositId} {
      allow read, write: if true;
    }

    // Withdrawals Collection
    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }

    // Plans Collection (Public read, admin/platform write)
    match /plans/{planId} {
      allow read, write: if true;
    }

    // Investments Collection
    match /investments/{investmentId} {
      allow read, write: if true;
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Referrals Collection
    match /referrals/{referralId} {
      allow read, write: if true;
    }

    // Daily Tasks Collection
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    // Platform Settings
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
